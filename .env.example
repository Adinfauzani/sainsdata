# Salin ke .env dan isi sendiri — jangan commit .env
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_NON_POOLING=postgresql://user:password@host/db?sslmode=require
PORT=8787
# Wajib di Vercel untuk upload file ke Blob Storage (opsional: dipakai juga
# saat menjalankan dev server jika ingin menyimpan upload langsung ke Blob).
# Ambil dari Vercel: Project > Storage > Blob (hubungkan ke project, token
# otomatis terpasang di environment variables). Store boleh Public atau Private
# — kode mendeteksi otomatis: berkas pada store Private disajikan lewat
# /api/instrumen/file/... karena URL-nya tidak bisa dibuka langsung di browser.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx
# Password akun admin default ('admin') saat seed
ADMIN_PASSWORD=admin123

# --- GitHub OAuth (Auth.js-style variable names) ---
# Rahasia untuk menandatangani cookie state OAuth. Wajib jika GitHub OAuth dipakai.
# Hasilkan dengan: openssl rand -base64 32
AUTH_SECRET=
# Kredensial OAuth App GitHub (Settings > Developer settings > OAuth Apps).
# Callback URL: http://localhost:3000/api/auth/github/callback (dev)
#               https://<domain-produksi>/api/auth/github/callback (produksi)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Opsional: timpa redirect URI bila domain di belakang proxy tidak terdeteksi.
# AUTH_GITHUB_REDIRECT_URI=https://contoh.ac.id/api/auth/github/callback